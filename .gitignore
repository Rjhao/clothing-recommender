# ===== Secrets (绝对不要提交) =====
.env
.env.local
.env.*.local
# .env.example 保留作为模板

# ===== 大数据文件 (可通过 data/import_*.py 重新生成) =====
# 2.8GB 的 Amazon 原始数据集
data/*.csv.gz
data/*.csv
data/*.parquet
# 保留 data/*.json (仅 6.4M, 让 clone 后可直接导入)
# 保留所有 data/*.py 脚本

# ===== 第三方/大模型代码 (单独 clone, 见 TRYON_SETUP.md) =====
ACGPN/
hr_viton/
# shop-tryon-skill 是独立 clone 的 skill 包 (自带 .git), 提交会成为断链的 gitlink
shop-tryon-skill/

# ===== 模型权重 (单个 46-66MB) =====
# 改为入库: .gitattributes 的 `*.pt filter=lfs` 会把权重转成 LFS 指针,
# 仓库里只存约 130 字节指针, 大文件落在 LFS 存储 (GitHub Free 含 10 GiB)。
# 同目录的 *.json 指标与 history 一并保留。

# ===== 根目录 tryon 调试图 (非论文图表, 论文配图在 figures/) =====
/compare_grid_*.png
/eval_compare_grid*.png
/test_*_parse.png
/tryon_*.png

# ===== Try-on 运行时上传/结果 =====
static/uploads/
static/results/

# ===== 下载的二进制模型 (非源码) =====
# static/models/u2net.onnx = 172MB GrabCut 抠图权重
static/models/u2net.onnx

# ===== 脚本生成的 3D 试穿模型 (见 gen_clothing_glb.py) =====
frontend/public/models/clothes/

# ===== 仓库外进程反复重写的早期基线记录 =====
# 内容每次都不同且与论文表4-5 矛盾(RippleNet 0.4731 vs 论文 0.5153)，
# 仓库内无任何脚本引用它，疑为 IDE 或外部脚本产物。永不入库。
experiments/baseline_comparison.json

